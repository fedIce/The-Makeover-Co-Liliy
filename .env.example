# App
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Tunnel (Cloudflare quick tunnel): run `npm run tunnel` in a second terminal, then set
# AUTH_URL, NEXT_PUBLIC_APP_URL, and GOOGLE_REDIRECT_URI to the https://….trycloudflare.com URL and restart `npm run dev`.
ADMIN_EMAILS="lilly@themakeoverco.com"
TOKEN_ENCRYPTION_KEY="32-char-minimum-secret-key!!!!!!"

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Email (Resend) — free tier can only send to your Resend account email
RESEND_API_KEY="re_xxx"
EMAIL_FROM="The Makeover Co. <onboarding@resend.dev>"
AUTH_DEV_MODE="true"
NEXT_PUBLIC_AUTH_DEV_MODE="true"

# Stripe (set PAYMENT_DEV_MODE=false when using real/test Stripe keys)
PAYMENT_DEV_MODE="true"
NEXT_PUBLIC_PAYMENT_DEV_MODE="true"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# Google Calendar (OAuth for Lilly)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
